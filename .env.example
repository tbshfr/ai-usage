# Copy to .env and fill in real values. Do NOT commit .env.
# Generate with: openssl rand -hex 32
AI_USAGE_DASHBOARD_USER=admin
AI_USAGE_DASHBOARD_PASSWORD=change-me-long-random-password
AI_USAGE_OTLP_TOKEN=change-me-long-random-token

# Optional R2 backups: uncomment all entries and the Compose backup block.
# See docs/backups.md for bucket lifecycle setup (start with 7 days).
# AI_USAGE_BACKUP_S3_BUCKET=ai-usage-backups
# AI_USAGE_BACKUP_S3_REGION=auto
# AI_USAGE_BACKUP_S3_PREFIX=ai-usage/home/
# AI_USAGE_BACKUP_S3_ENDPOINT=https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# AI_USAGE_BACKUP_S3_ACCESS_KEY_ID=<R2_ACCESS_KEY_ID>
# AI_USAGE_BACKUP_S3_SECRET_ACCESS_KEY=<R2_SECRET_ACCESS_KEY>
